# ============================================================
# Copie para .env e preencha. NUNCA versione o .env.
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
#
# Gere a SECRET_KEY com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

FLASK_ENV=development
SECRET_KEY=troque-esta-chave-antes-de-subir

# Banco -------------------------------------------------------
# Deixe comentado para usar o SQLite na raiz do projeto.
# ATENÇÃO: caminho relativo em SQLite é resolvido dentro da pasta
# instance/, não na raiz — se preencher, use caminho absoluto.
#   Linux:      sqlite:////caminho/completo/rdm.db
#   PostgreSQL: postgresql+psycopg://usuario:senha@host:5432/rdm
# DATABASE_URL=

# Sessão ------------------------------------------------------
SESSION_LIFETIME_MIN=30

# Domínios de e-mail autorizados a acessar o sistema ----------
ALLOWED_EMAIL_DOMAINS=exemplo.com.br,exemplo.com.br

# ============================================================
# ENVIO DE E-MAIL
# Dois mecanismos. Deixe EMAIL_BACKEND=auto: com as credenciais
# da Graph preenchidas ele usa a Graph, senão cai no SMTP.
# ============================================================
EMAIL_BACKEND=auto

EMAIL_REMETENTE=
EMAIL_NOME_REMETENTE=Gestao de Mudancas - TI
# Destinatários fixos que sempre recebem cópia (separados por vírgula)
EMAIL_COPIA_PADRAO=

# --- Microsoft Graph (recomendado) ---------------------------
# Não usa senha. Exige registro de aplicativo no Entra ID com
# permissão Mail.Send. Veja o passo a passo no README.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- SMTP (alternativa) --------------------------------------
# A Microsoft desativou este método na maioria dos tenants e vai
# removê-lo. Use apenas em provedores que ainda o suportam.
# SMTP_USER e EMAIL_REMETENTE precisam ser o MESMO endereço.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Bootstrap do primeiro administrador -------------------------
# Usado apenas pelo comando: flask criar-admin
ADMIN_EMAIL=
ADMIN_NOME=

# Bloqueio de conta -------------------------------------------
MAX_TENTATIVAS_LOGIN=5
BLOQUEIO_MINUTOS=15

# Docker Compose ----------------------------------------------
POSTGRES_PASSWORD=
# Com mais de um worker, o limite em memória não é compartilhado:
RATELIMIT_STORAGE_URI=memory://
