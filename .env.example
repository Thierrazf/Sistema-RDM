# ============================================================
# Copie para .env e preencha. NUNCA versione o .env.
# Gere a SECRET_KEY com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================

FLASK_ENV=development
SECRET_KEY=troque-esta-chave-antes-de-subir

# Banco -------------------------------------------------------
# SQLite (dev):     sqlite:///rdm.db
# PostgreSQL (prd): postgresql+psycopg://usuario:senha@host:5432/rdm
DATABASE_URL=sqlite:///rdm.db

# Sessão ------------------------------------------------------
SESSION_LIFETIME_MIN=30

# Domínios de e-mail autorizados a acessar o sistema ----------
ALLOWED_EMAIL_DOMAINS=exemplo.com.br,exemplo.com.br

# SMTP --------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=
EMAIL_NOME_REMETENTE=Gestao de Mudancas - TI
# Destinatários fixos que sempre recebem cópia (separados por vírgula)
EMAIL_COPIA_PADRAO=

# Bootstrap do primeiro administrador -------------------------
# Usado apenas pelo comando: flask criar-admin
ADMIN_EMAIL=
ADMIN_NOME=

# Bloqueio de conta -------------------------------------------
MAX_TENTATIVAS_LOGIN=5
BLOQUEIO_MINUTOS=15

# Docker Compose ----------------------------------------------
POSTGRES_PASSWORD=
# Com mais de um worker, o limite em memória não é compartilhado:
RATELIMIT_STORAGE_URI=memory://
